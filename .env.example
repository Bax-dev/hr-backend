DJANGO_DEBUG=True
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Proxies in front of the app that append to X-Forwarded-For (2 on AWS: CloudFront + ALB).
# Use 0 locally, where nothing sits in front of runserver.
DJANGO_TRUSTED_PROXY_HOPS=0
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# Encrypts two-step verification (TOTP) secrets at rest. Set this in every deployed
# environment; if unset, a key is derived from DJANGO_SECRET_KEY, and rotating that
# key would then invalidate every MFA enrolment.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

DB_NAME=hr_app_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_CONN_HEALTH_CHECKS=True
DB_CONNECT_TIMEOUT=5
DB_SSLMODE=prefer

REDIS_URL=redis://127.0.0.1:6379/1
FRONTEND_LOGIN_URL=http://localhost:3000/login
# Employee invitations derive /accept-invite from this frontend URL.
FRONTEND_BILLING_URL=http://localhost:3000/billing/start
# Origins Paystack may redirect back to after checkout (comma-separated). Falls back to
# the FRONTEND_* URLs above. Local: http://localhost:3000
PAYMENT_CALLBACK_ALLOWED_ORIGINS=http://localhost:3000

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_USE_SSL=False
# Resend requires this domain to be verified before delivery.
# 'resend' sends real email. 'console' prints each email (OTP codes, invite links) to the
# server log instead; local development only, refused unless DJANGO_DEBUG=True.
EMAIL_DELIVERY=resend
DJANGO_DEFAULT_FROM_EMAIL=noreply@workiva.com.ng
RESEND_API_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=us-east-1
# Bedrock AI assistant (uses the server/ECS task IAM role; never add AWS keys here).
AI_ASSISTANT_ENABLED=True
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_MAX_TOKENS=1200
# Optional for S3-compatible local/test storage. Leave blank for AWS S3.
AWS_S3_ENDPOINT_URL=
# File Management module: encrypts each org's own S3 access/secret keys at
# rest (Settings > File Management). 32+ random characters, generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
FILE_STORAGE_ENCRYPTION_KEY=
# Logo shown in transactional emails. Leave blank to use the prod default.
EMAIL_LOGO_URL=

# Bootstraps a Django /admin/ superuser: python manage.py create_superadmin
# Leave both unset to skip bootstrap entirely (safe default). Must satisfy
# AUTH_PASSWORD_VALIDATORS (settings.py) — the command rejects weak values.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
